<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Node.fs" />
    <Compile Include="MathTests.fs" />
    <Compile Include="SceneTests.fs" />
    <Compile Include="AddonTests.fs" />
    <!-- Browser code that must type-check and compile; it is never run under Node. -->
    <Compile Include="BrowserApi.fs" />
    <Compile Include="Readme.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Fable.Three\Fable.Three.fsproj" />
    <PackageReference Include="Fable.Promise" Version="3.2.0" />
  </ItemGroup>

</Project>
